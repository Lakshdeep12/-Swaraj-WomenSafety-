# Asha-Alita Women Safety Platform - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

ENVIRONMENT=production
DEBUG=false
APP_NAME="Asha-Alita"
APP_VERSION=1.0.0
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL recommended for production
# DATABASE_URL=postgresql://user:password@localhost:5432/asha_alita_db

# SQLite for development/testing
DATABASE_URL=mysql://root:lakshdeep_12@your_db_host:3306/alita

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=8fc0d320ad0ebb84b86a3764cda62c17

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/app.log
AUDIT_LOG_FILE=logs/audit.log

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================

RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# SOS-specific rate limiting (5 SOS per hour)
SOS_RATE_LIMIT_CALLS=5
SOS_RATE_LIMIT_PERIOD=3600
SOS_COOLDOWN_MINUTES=15

# ML endpoint rate limiting (30 calls per minute)
ML_RATE_LIMIT_CALLS=30
ML_RATE_LIMIT_PERIOD=60

# ============================================================================
# ML MODEL CONFIGURATION
# ============================================================================

ENABLE_ML_STRESS_DETECTION=true
ENABLE_SAFE_ROUTE=true
ENABLE_BLOCKCHAIN_AUDIT=false
ENABLE_TWILIO_SMS=false

STRESS_MODEL_PATH=models/stress_detection.pkl
SAFE_ROUTE_MODEL_PATH=models/safe_route.pkl
ML_INFERENCE_TIMEOUT=30

# ============================================================================
# LOCATION SERVICES
# ============================================================================

# Get API key from https://cloud.google.com/maps-platform
GOOGLE_MAPS_API_KEY=AIzaSyBg3rJ211V-4bZaM73yKap1_iLu4VMoVYE

MAX_LOCATION_HISTORY=1000
LOCATION_UPDATE_INTERVAL=30

# ============================================================================
# NOTIFICATION CONFIGURATION
# ============================================================================

NOTIFICATION_SERVICE=email

# Email configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=lakshdeeps021@gmail.com
EMAIL_PASSWORD=Lakshsdeep_12

# Twilio SMS configuration (optional)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================

ADMIN_EMAIL=kunwar.lakshdeep@gmail.com
ADMIN_PHONE=9257159368

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# For Flutter app
# CORS_ORIGINS=["capacitor://localhost", "ionic://localhost", "http://localhost:8100"]

# For web (React/Vue)
# CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://asha-alita.com"]

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable blockchain audit trail (future enhancement)
ENABLE_BLOCKCHAIN_AUDIT=false

# Enable SMS notifications via Twilio
ENABLE_TWILIO_SMS=false
